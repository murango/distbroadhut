# Netlify headers file. Keep it named _headers, in the same folder as index.html.
# Comments must start at the beginning of a line.

# SECURITY HEADERS, every page
# The Content-Security-Policy line below is a trial run (Report-Only): problems show in the
# browser console but nothing is blocked. After a clean check (open every window, send a test
# form), rename "Content-Security-Policy-Report-Only" to "Content-Security-Policy".
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://www.googletagmanager.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.ufs.sh https://www.google-analytics.com https://*.google-analytics.com; frame-src https://tally.so https://www.openstreetmap.org; connect-src 'self' https://tally.so https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://us.i.posthog.com https://eu.i.posthog.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://plausible.io; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://tally.so; frame-ancestors 'none'; upgrade-insecure-requests

# CACHING
# Built CSS and JS carry a fingerprint in the file name, so they can be cached for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Window fragments and the search index are loaded in the background and kept out of search results
/w/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex
/search-index.json
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex
# The page: always check for a fresh copy, so edits go live straight away
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker must never be cached for long
/sw.js
  Cache-Control: no-cache

# Images and icons: 1 year. These file names are not versioned, so if you replace one,
# give the new file a new name (for example logo-v2.png).
/og-image.jpg
  Cache-Control: public, max-age=31536000, immutable
/logo.png
  Cache-Control: public, max-age=31536000, immutable
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
# Anything you later place in an /assets folder gets the same treatment
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Crawler files: refresh daily
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# Security contact file
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
